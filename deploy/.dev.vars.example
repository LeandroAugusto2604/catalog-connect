# ============================================================================
# Variáveis RUNTIME do worker (server-only, NUNCA vão para o navegador).
# Copie para deploy/.dev.vars e preencha. Esse arquivo é montado read-only
# dentro do container pelo docker-compose.
# ============================================================================

# --- Supabase próprio ---
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "eyJhbGciOi..."          # anon key
SUPABASE_SERVICE_ROLE_KEY = "eyJhbGciOi..."         # service role (SECRETA)

# --- E-mails de orçamento (envio via SMTP do Gmail) ---
# A integração antiga usava o conector Gmail da Lovable, que NÃO funciona
# fora da infra Lovable. Para a VPS, gere uma "Senha de app" em
# https://myaccount.google.com/apppasswords e preencha abaixo.
# Você precisará ajustar src/lib/quotes.server.ts para usar SMTP em vez
# do gateway da Lovable (passo descrito no README).
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "465"
SMTP_USER = "leandro.soneca186@gmail.com"
SMTP_PASS = "xxxx xxxx xxxx xxxx"
SMTP_FROM = "leandro.soneca186@gmail.com"
ADMIN_EMAIL = "leandro.soneca186@gmail.com"